@{ ViewData["Title"] = "Iniciar sesión"; }
<div class="row justify-content-center"><div class="col-md-5">
<div class="card card-acceso shadow-sm"><div class="card-body p-4">
    <h1 class="h3 titulo-rojo mb-1">Taller de Soldadura</h1>
    <p class="text-muted">Inicia sesión con tu cuenta institucional.</p>
    <form asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div class="mb-3"><label class="form-label">Correo institucional</label>
            <input name="correo" type="email" class="form-control" required autofocus /></div>
        <div class="mb-3"><label class="form-label">Contraseña</label>
            <input name="contrasena" type="password" class="form-control" required /></div>
        <button class="btn btn-primary w-100">Entrar</button>
    </form>
</div></div></div></div>
