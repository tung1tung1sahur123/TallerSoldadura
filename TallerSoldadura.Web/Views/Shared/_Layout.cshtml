<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Taller de Soldadura UNE</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark une-nav mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Taller de Soldadura · UNE</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("alumno"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Reservaciones" asp-action="Calendario">Calendario</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reservaciones" asp-action="Nueva">Nueva solicitud</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reservaciones" asp-action="Mias">Mis reservaciones</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reservaciones" asp-action="Avisos">Avisos</a></li>
                    }
                    @if (User.IsInRole("maestro"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Maestro" asp-action="Pendientes">Solicitudes</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Maestro" asp-action="DelDia">Reservaciones del día</a></li>
                    }
                    @if (User.IsInRole("maestro") || User.IsInRole("administrador"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="HistorialUso">Historial de uso</a></li>
                    }
                    @if (User.IsInRole("administrador"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Horarios" asp-action="Index">Horarios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reportes" asp-action="Bitacora">Bitácora</a></li>
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="navbar-text text-white me-3">@User.Identity.Name</span>
                    <form asp-controller="Cuenta" asp-action="Logout" method="post" class="d-inline">
                        <button class="btn btn-sm btn-outline-light">Cerrar sesión</button>
                    </form>
                }
            </div>
        </div>
    </nav>
    <main class="container pb-5">
        @if (TempData["msg"] is string msg)
        {
            <div class="alert @(TempData["ok"] is true ? "alert-success" : "alert-danger") alert-dismissible fade show">
                @msg <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (ViewData["Error"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }
        @RenderBody()
    </main>
    <div class="une-barra"></div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
