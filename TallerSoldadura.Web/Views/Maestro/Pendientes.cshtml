@model List<Reservacion>
@{ ViewData["Title"] = "Solicitudes pendientes"; }
<h1>Solicitudes pendientes</h1>
<table class="table table-bordered bg-white align-middle">
    <thead><tr><th>Folio</th><th>Alumno</th><th>Matrícula</th><th>Fecha</th><th>Horario</th><th style="width:40%">Revisión</th></tr></thead>
    <tbody>
    @if (Model.Count == 0) { <tr><td colspan="6">No hay solicitudes pendientes.</td></tr> }
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.IdReservacion</td><td>@r.Alumno.NombreCompleto</td><td>@r.Alumno.Matricula</td>
            <td>@r.FechaUso.ToString("dd/MM/yyyy")</td>
            <td>@r.HoraEntrada.ToString("HH\\:mm") – @r.HoraSalida.ToString("HH\\:mm")</td>
            <td>
                <form asp-action="Revisar" asp-route-id="@r.IdReservacion" method="post" class="d-flex gap-2">
                    <input name="comentario" maxlength="500" class="form-control form-control-sm" placeholder="Comentario (opcional)" />
                    <button name="autorizar" value="true" class="btn btn-sm btn-success">Autorizar</button>
                    <button name="autorizar" value="false" class="btn btn-sm btn-danger">Rechazar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
