@model Reservacion
@{ ViewData["Title"] = "Nueva solicitud"; }
<h1>Solicitud de uso del taller</h1>
<p class="text-muted">Solicitante: <strong>@User.Identity?.Name</strong> · @User.FindFirstValue(ClaimTypes.Email)</p>
<form asp-action="Nueva" method="post" class="card card-body bg-white" style="max-width:520px">
    <div class="mb-3"><label class="form-label">Fecha de uso</label>
        <input type="date" name="fechaUso" value="@Model.FechaUso.ToString("yyyy-MM-dd")" class="form-control" required /></div>
    <div class="row">
        <div class="col mb-3"><label class="form-label">Hora de entrada</label>
            <input type="time" name="horaEntrada" value="@Model.HoraEntrada.ToString("HH\\:mm")" class="form-control" required /></div>
        <div class="col mb-3"><label class="form-label">Hora de salida</label>
            <input type="time" name="horaSalida" value="@Model.HoraSalida.ToString("HH\\:mm")" class="form-control" required /></div>
    </div>
    <button class="btn btn-primary">Enviar solicitud</button>
</form>
