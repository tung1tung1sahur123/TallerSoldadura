@model List<Reservacion>
@{
    ViewData["Title"] = "Calendario";
    var fecha = (DateOnly)ViewBag.Fecha;
    var franjas = (List<HorarioApertura>)ViewBag.Franjas;
    var pendientes = (List<Reservacion>)ViewBag.MisPendientes;
}
<h1>Calendario del taller</h1>
<form method="get" class="row g-2 align-items-end mb-3 no-print">
    <div class="col-auto"><label class="form-label">Fecha</label>
        <input type="date" name="fecha" value="@fecha.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Consultar</button></div>
    <div class="col-auto"><a class="btn btn-primary" asp-action="Nueva" asp-route-fecha="@fecha.ToString("yyyy-MM-dd")">Solicitar este día</a></div>
</form>
<h5>@fecha.ToString("dddd dd/MM/yyyy", new System.Globalization.CultureInfo("es-MX"))</h5>
@if (franjas.Count == 0)
{
    <div class="alert alert-secondary">El taller está cerrado este día.</div>
}
else
{
    <p><strong>Horario de apertura:</strong> @string.Join(" y ", franjas.Select(f => $"{f.HoraApertura:HH\\:mm}–{f.HoraCierre:HH\\:mm}"))</p>
    <table class="table table-bordered bg-white">
        <thead><tr><th>Horario ocupado</th><th>Estado</th></tr></thead>
        <tbody>
        @if (Model.Count == 0) { <tr><td colspan="2" class="text-success">Todo el horario está disponible.</td></tr> }
        @foreach (var r in Model)
        {
            <tr><td>@r.HoraEntrada.ToString("HH\\:mm") – @r.HoraSalida.ToString("HH\\:mm")</td><td><span class="badge autorizada">ocupado</span></td></tr>
        }
        </tbody>
    </table>
    @if (pendientes.Count > 0)
    {
        <div class="alert alert-warning">Tienes @pendientes.Count solicitud(es) pendiente(s) este día: @string.Join(", ", pendientes.Select(p => $"{p.HoraEntrada:HH\\:mm}–{p.HoraSalida:HH\\:mm}")). No bloquean el horario hasta que se autoricen.</div>
    }
}
